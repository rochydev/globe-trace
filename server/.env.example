# Copia este archivo a .env y ajusta lo que necesites. Todos tienen valor por defecto.
# npm run dev / npm start lo cargan automáticamente si existe.

# Dirección y puerto. 127.0.0.1 = solo accesible desde esta máquina.
HOST=127.0.0.1
PORT=8790

# Saltos máximos (tope absoluto de 64 aunque se ponga más)
MAX_HOPS=30
# Tiempo máximo total de un trace; después se mata el proceso
TRACE_TIMEOUT_MS=60000
# Espera por cada sonda
PROBE_TIMEOUT_MS=1000
# Saltos seguidos sin respuesta tras los que se corta el trace
MAX_SILENT_HOPS=5

# Rate limit por IP de cliente: N traces por ventana
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000

# Procesos de traceroute vivos a la vez (en total y por IP)
MAX_CONCURRENT_TRACES=4
MAX_CONCURRENT_PER_IP=1

# Orígenes permitidos para CORS, separados por comas (vacío = ninguno)
# CORS_ORIGINS=https://rochydev.github.io

# Solo "true" si hay un proxy inverso PROPIO delante (nginx, Caddy...)
TRUST_PROXY=false

# ─── Geolocalización ───
# auto = MaxMind si hay bases en server/data, si no ip-api | maxmind | ipapi | none
GEO_PROVIDER=auto
# Credenciales para "npm run geo:update" (cuenta gratuita en maxmind.com)
# MAXMIND_ACCOUNT_ID=
# MAXMIND_LICENSE_KEY=
# Ubicación del servidor (punto de salida del trace): lat,lon,Ciudad,CC
# ORIGIN=41.3874,2.1686,Barcelona,ES
